{
  "name": "shiftvault",
  "version": "1.1.0",
  "description": "Free, open-source, offline-first personal finance and shift tracker for Android.",
  "author": "ShiftVault contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "icons": "python3 scripts/gen-icons.py",
    "android:add": "cap add android && node scripts/prepare-android.mjs",
    "android:sync": "cap sync android && node scripts/prepare-android.mjs",
    "android:apk": "cap add android && node scripts/prepare-android.mjs && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
